# Gabarit des variables d'environnement.
# Copier en `.env.local` et renseigner les valeurs. Ne jamais committer `.env.local`.

# Supabase — exposées au navigateur, donc publiques par nature.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — secret. Ne doit JAMAIS être importé dans un composant client
# ni préfixé par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
